# Copy this file to .env and adjust the values.

# Port the API listens on
PORT=4000

# MongoDB connection string (local Docker container, or a MongoDB Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017/lms

# Secret used to sign JWTs. Use a long random string in production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Frontend origin(s) allowed by CORS, comma separated
CLIENT_ORIGIN=http://localhost:3000
